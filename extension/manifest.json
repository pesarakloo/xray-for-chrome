{
  "manifest_version": 3,
  "name": "Xray for Chrome",
  "version": "0.3.9",
  "description": "اجرای Xray فقط برای ترافیک Google Chrome در Windows و macOS",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "privacy",
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Xray for Chrome",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
